# Copy to .env and fill in.
DATABASE_URL=postgresql://postgres:password@localhost:5432/rentshield
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/rentshield_test
JWT_SECRET=change-me-to-a-long-random-string
PORT=4100
APP_URL=http://localhost:5174
STORAGE_DIR=./storage

# Optional: AI help assistant. Without a key it answers from a built-in FAQ.
# Free: create a Gemini key at https://aistudio.google.com (no card needed)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite
# Or Claude: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
