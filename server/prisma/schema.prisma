// RentShield database schema. See docs/DESIGN.md section 5.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartyRole {
  LANDLORD
  TENANT
}

enum PropertyType {
  APARTMENT
  INDEPENDENT_HOUSE
  ROOM
  PG
}

enum LeaseStatus {
  ACTIVE
  MOVED_OUT
  SETTLED
}

enum InspectionType {
  MOVE_IN
  MOVE_OUT
}

enum InspectionStatus {
  DRAFT
  SUBMITTED
  FINALIZED
}

enum Condition {
  GOOD
  FAIR
  DAMAGED
  MISSING
  NOT_APPLICABLE
}

enum ReviewStatus {
  PENDING
  APPROVED
  DISPUTED
  NOTED // reviewer disagrees, but both views are recorded so the inspection can still lock
}

enum LocationSource {
  EXIF // GPS embedded in the photo by the camera
  DEVICE // reported by the browser at capture time
}

enum EvidenceKind {
  PHOTO
  INVOICE
}

enum SettlementStatus {
  OPEN
  AGREED
}

enum DeductionStatus {
  PROPOSED
  ACCEPTED
  DISPUTED
  WITHDRAWN
}

enum ReportStatus {
  PENDING
  READY
  FAILED
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  asLandlord    Lease[]        @relation("LeaseLandlord")
  asTenant      Lease[]        @relation("LeaseTenant")
  evidence      Evidence[]
  auditEvents   AuditEvent[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Property {
  id           Int          @id @default(autoincrement())
  addressLine  String
  city         String
  propertyType PropertyType
  // Pinned on the map by either party; used to check where photos were taken.
  latitude     Float?
  longitude    Float?
  createdAt    DateTime     @default(now())
  rooms        Room[]
  leases       Lease[]
}

model Room {
  id         Int              @id @default(autoincrement())
  propertyId Int
  property   Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int              @default(0)
  items      InspectionItem[]

  @@index([propertyId])
}

model Lease {
  id              Int          @id @default(autoincrement())
  propertyId      Int
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Each side is null until that party accepts the invitation.
  landlordId      Int?
  landlord        User?        @relation("LeaseLandlord", fields: [landlordId], references: [id], onDelete: SetNull)
  tenantId        Int?
  tenant          User?        @relation("LeaseTenant", fields: [tenantId], references: [id], onDelete: SetNull)
  startDate       DateTime     @db.Date
  endDate         DateTime?    @db.Date
  monthlyRent     Int // whole rupees
  securityDeposit Int // whole rupees
  status          LeaseStatus  @default(ACTIVE)
  createdAt       DateTime     @default(now())
  invitations     Invitation[]
  inspections     Inspection[]
  settlement      Settlement?
  reports         Report[]
  auditEvents     AuditEvent[]

  @@index([landlordId])
  @@index([tenantId])
}

model Invitation {
  id           Int       @id @default(autoincrement())
  leaseId      Int
  lease        Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  role         PartyRole // the role the invitee will take
  tokenHash    String    @unique
  createdById  Int
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById Int?
  createdAt    DateTime  @default(now())

  @@index([leaseId])
}

model Inspection {
  id                  Int              @id @default(autoincrement())
  leaseId             Int
  lease               Lease            @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  type                InspectionType
  status              InspectionStatus @default(DRAFT)
  // The party who documents; the other party reviews.
  authorId            Int
  electricityReading  String?
  waterReading        String?
  gasReading          String?
  generalNotes        String?
  submittedAt         DateTime?
  finalizedAt         DateTime?
  createdAt           DateTime         @default(now())
  items               InspectionItem[]

  @@unique([leaseId, type]) // one move-in and one move-out per tenancy
}

model InspectionItem {
  id             Int              @id @default(autoincrement())
  inspectionId   Int
  inspection     Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  roomId         Int
  room           Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int              @default(0)
  condition      Condition?
  notes          String?
  reviewStatus   ReviewStatus     @default(PENDING)
  reviewComment  String?
  // Optimistic locking: every write must send the version it read.
  version        Int              @default(1)
  // Move-out items point at the move-in item they're compared with.
  baselineItemId Int?
  baselineItem   InspectionItem?  @relation("Baseline", fields: [baselineItemId], references: [id], onDelete: SetNull)
  moveOutItems   InspectionItem[] @relation("Baseline")
  updatedAt      DateTime         @updatedAt
  evidence       Evidence[]
  deductions     Deduction[]

  @@index([inspectionId])
}

model Evidence {
  id           Int             @id @default(autoincrement())
  kind         EvidenceKind
  itemId       Int?
  item         InspectionItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  deductionId  Int?
  deduction    Deduction?      @relation(fields: [deductionId], references: [id], onDelete: Cascade)
  uploadedById Int
  uploadedBy   User            @relation(fields: [uploadedById], references: [id])
  storageKey   String          @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedAt   DateTime        @default(now())
  // From the photo's EXIF metadata (or the device, for in-app camera shots).
  takenAt        DateTime?
  latitude       Float?
  longitude      Float?
  locationSource LocationSource?

  @@index([itemId])
  @@index([deductionId])
}

model Settlement {
  id                  Int              @id @default(autoincrement())
  leaseId             Int              @unique
  lease               Lease            @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  depositAmount       Int
  status              SettlementStatus @default(OPEN)
  landlordConfirmedAt DateTime?
  tenantConfirmedAt   DateTime?
  agreedAt            DateTime?
  finalRefund         Int?
  createdAt           DateTime         @default(now())
  deductions          Deduction[]
}

model Deduction {
  id            Int             @id @default(autoincrement())
  settlementId  Int
  settlement    Settlement      @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  itemId        Int? // the move-out inspection item this charge is about
  item          InspectionItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  reason        String
  amount        Int
  status        DeductionStatus @default(PROPOSED)
  tenantComment String?
  version       Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  evidence      Evidence[]

  @@index([settlementId])
}

model Report {
  id            Int          @id @default(autoincrement())
  leaseId       Int
  lease         Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  status        ReportStatus @default(PENDING)
  storageKey    String?
  sha256        String?
  error         String?
  requestedById Int
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([leaseId])
}

/// Append-only, hash-chained per lease: hash = SHA256(prevHash + payload).
model AuditEvent {
  id         Int      @id @default(autoincrement())
  leaseId    Int
  lease      Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   Int?
  data       Json?
  prevHash   String
  hash       String   @unique
  createdAt  DateTime @default(now())

  @@index([leaseId, id])
}
